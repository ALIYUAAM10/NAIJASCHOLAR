rules_version = '2';

// NaijaPrep is server-first. Clients authenticate with Firebase Auth, but all
// Firestore reads and writes go through the Vercel API using the Admin SDK.
// Admin SDK access bypasses these rules. Deny everything else by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
