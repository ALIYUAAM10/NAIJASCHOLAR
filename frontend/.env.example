# Copy to frontend/.env.local for local development.
# Vite proxies /api to http://localhost:3000 when running `vercel dev`.
VITE_API_BASE_URL=/api

# Public Firebase client identifiers from Firebase Console > Project settings.
# These are not secrets, but they are required for Firebase Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set to true only when `npm run emulators` is running.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
