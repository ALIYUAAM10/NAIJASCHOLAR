{
    "name": "NaijaPrep-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "sync:fonts": "mkdir -p public/fonts && cp node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 public/fonts/ && cp node_modules/@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2 public/fonts/",
        "predev": "npm run sync:fonts",
        "dev": "vite",
        "prebuild": "npm run sync:fonts",
        "build": "vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "autoprefixer": "^10.4.20",
        "firebase": "^11.0.0",
        "postcss": "^8.4.49",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^3.4.17",
        "vite": "^5.4.10"
    }
}
