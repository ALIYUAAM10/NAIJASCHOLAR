# ---------------------------------------------------------------------------
# Server-only values. Never expose these with a VITE_ prefix.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key-using-\\n-escapes"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Enforce Firebase App Check on protected API routes. Keep false locally.
APP_CHECK_ENFORCE=false

# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4173

# Salt used only to shorten user IDs in logs. Use 32+ random bytes in production.
LOG_HASH_SALT=replace-with-a-long-random-string

# Shared secret for the reminder cron endpoint. Required in production.
CRON_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Firebase client configuration (public identifiers, not secrets).
# Vite only reads variables from frontend/.env.local, so duplicate these there.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_API_BASE_URL=/api

# Local emulator use only. Keep false in production.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Local emulator hosts for server-only code (Vercel Functions and seed scripts).
# Leave unset in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
