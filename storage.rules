rules_version = '2';

// Uploads use short-lived signed PUT URLs issued by the API. Downloads use
// short-lived signed GET URLs. The Firebase Storage SDK is never used directly
// by the browser, so direct client access is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
